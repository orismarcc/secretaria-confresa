# Copie para .env e preencha. NÃO comite o .env.
SUPABASE_URL=https://pqvsdzvmbwbotkfggcxc.supabase.co
# Chave service_role (a mesma do .env.local do projeto). Mantenha em segredo.
SUPABASE_SERVICE_ROLE_KEY=coloque_a_chave_service_role_aqui

# Horário do envio diário (24h) e fuso. Para 7h de Brasília use America/Sao_Paulo.
SEND_AT=07:00
TIMEZONE=America/Sao_Paulo

# Opcional: parear por CÓDIGO de 8 dígitos em vez de QR (útil em servidor sem tela).
# Coloque o número da secretaria (só dígitos): 55 + DDD + número.
# PAIR_PHONE=5566999998888

# Opcional: caminho de outro arquivo de destinatários.
# RECIPIENTS_FILE=./recipients.json
